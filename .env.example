# 複製為 .env.local 後修改
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# 後台登入（email 必須相符，再輸入密碼）
ADMIN_EMAIL=admin@kuan.tw
ADMIN_PASSWORD=kuan-admin-demo

# SQLite 路徑（相對於專案根目錄）
DATABASE_PATH=./data/kuan.sqlite

# 名額上限（預設 20）
SEAT_CAP=20

# 未設定 SMTP 時，登入頁會直接顯示魔術連結（本機開發用）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=寬數週練 <noreply@kuan.tw>
